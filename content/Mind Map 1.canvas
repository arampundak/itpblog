		{"id":"915c805b645db323","type":"text","text":"He want to play","x":-156,"y":-2746,"width":147,"height":60},
		{"id":"5693ae6f79057462","type":"text","text":"sometimes I dont","x":101,"y":-2746,"width":159,"height":60},
