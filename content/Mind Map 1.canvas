		{"id":"e6bb1e543a40605c","type":"text","text":"They all look the same","x":-941,"y":-40,"width":196,"height":60},
		{"id":"d22cce1103a3d818","type":"text","text":"I want mine different","x":-617,"y":-64,"width":250,"height":60},
