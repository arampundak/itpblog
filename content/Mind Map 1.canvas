		{"id":"f59fc89f6bdf5503","type":"text","text":"Gap","x":-744,"y":270,"width":127,"height":60},
		{"id":"22ea58d5ecdbf2a4","type":"text","text":"\"As children, we wanted our toys to come alive. We spoke for them and decided what happened next. In turn, they gave us more to imagine.\n\nWith computers, our imaginations found an application: feed them instructions, and they perform.\"\n\nfrom: Body-Shop","x":-1871,"y":-1006,"width":250,"height":343},
		{"id":"088938937d6e66e9","type":"text","text":"We want to be seen","x":-675,"y":-2747,"width":177,"height":60},
