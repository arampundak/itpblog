		{"id":"3d0b130590bed149","x":-2594,"y":-1640,"width":436,"height":100,"color":"2","type":"group","label":"what politeness looks like in motion"},
		{"id":"c1fd83067a853a75","type":"text","text":"Treat robots like living things","x":-960,"y":-2016,"width":250,"height":60},
		{"id":"c88bef725cc641c4","type":"text","text":"Say \"thank you\" to our virtual agent","x":-623,"y":-2016,"width":197,"height":60},
		{"id":"4f83795e80423f75","type":"text","text":"Its a good thing because we might say more thank you to humans","x":-312,"y":-2036,"width":250,"height":101},
		{"id":"800b2871b0b2b660","type":"text","text":"We are programed to notice movement in the jungle","x":-965,"y":-2220,"width":160,"height":127},
